{
  "name": "gbfossilprep-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --port 5173",
    "test:merge": "esbuild scripts/test-merge.mts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-merge.mjs && node node_modules/.cache/test-merge.mjs",
    "test:rollback": "esbuild scripts/test-rollback.mts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-rollback.mjs && node node_modules/.cache/test-rollback.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^5.16.7",
    "@mui/material": "^5.16.7",
    "dexie": "^4.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
